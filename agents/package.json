{
  "name": "@anvil/agents",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/runner.js",
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:harness-verify": "vitest run src/testing/__tests__/harness-self-test.ts",
    "test:harness": "vitest run src/testing/__tests__/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@anthropic-ai/sdk": "^0.74.0",
    "glob": "^13.0.6",
    "nanoid": "^5.1.16",
    "node-forge": "^1.4.0",
    "sucrase": "^3.35.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@esbuild/darwin-arm64"
    ],
    "overrides": {
      "esbuild@>=0.27 <0.28.1": "^0.28.2",
      "vite@>=7 <7.3.5": "^7.3.5"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "vite": "^7.3.5"
  },
  "overrides": {
    "esbuild@>=0.27 <0.28.1": "^0.28.2"
  }
}
