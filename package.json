    "fractional-indexing": "^3.4.0",
    "glob": "^13.0.6",
    "katex": "^0.19.0",
    "lucide-react": "^0.562.0",
    "material-icon-theme": "^5.39.0",
    "mitt": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
